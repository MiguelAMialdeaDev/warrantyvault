<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="com.android.vending.BILLING" />
    <!--
      Lo añade WorkManager por si una tarea pide ejecutarse en primer plano. Aquí ninguna
      lo hace (los avisos son trabajos cortos), así que sobra en la ficha de permisos.
    -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />

    <application
        android:name=".WarrantyVaultApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WarrantyVault">
        <!-- Crashlytics no envía nada hasta que la app lo enciende según la preferencia de Ajustes. -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />
        <!--
          taskAffinity vacía: en Android 8 a 10 otra app podía declarar la misma afinidad y
          colarse en nuestra tarea (StrandHogg), haciéndose pasar por la app al pulsar el
          icono. Con una sola actividad no cambia nada de la navegación.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:screenOrientation="userPortrait"
            android:theme="@style/Theme.WarrantyVault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Entrada solo para el aviso de caducidad. Al no estar exportada, ninguna otra app
          puede lanzarla, así que MainActivity solo acepta el id de garantía cuando el
          intent llega por aquí y sigue vaciando cualquier extra que entre por el lanzador.
        -->
        <activity-alias
            android:name=".notifications.OpenWarrantyFromNotification"
            android:exported="false"
            android:targetActivity=".MainActivity" />

        <!-- Comparte el ticket con permiso temporal por uri. No exportado: nadie lo lee sin ese permiso. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
