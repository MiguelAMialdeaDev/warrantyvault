<?xml version="1.0" encoding="utf-8"?>
<!--
  Small icon de las notificaciones. Android solo usa el canal alfa de este drawable y lo
  tiñe él mismo, así que tiene que ser una silueta monocroma plana: el mipmap del
  launcher es un adaptive-icon y el sistema lo pintaba como un cuadrado sólido.

  El escudo se rellena y la marca de verificación se recorta con fillType evenOdd, que es
  lo que la hace visible sobre la silueta.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M12,1L3,5v6c0,5.55 3.84,10.74 9,12 5.16,-1.26 9,-6.45 9,-12V5L12,1z M10,17l-4,-4 1.41,-1.41L10,14.17l6.59,-6.59L18,9l-8,8z"/>
</vector>
