<?xml version="1.0" encoding="utf-8"?>
<!--
  Reglas legacy de Auto Backup (Android < 12). Respalda BD + DataStore y excluye las
  fotos de ticket por la misma razón que data_extraction_rules.xml: pasarse de la cuota
  de 25 MB tira el backup entero, no solo las fotos.
-->
<full-backup-content>
    <exclude domain="file" path="ticket_photos" />
</full-backup-content>
