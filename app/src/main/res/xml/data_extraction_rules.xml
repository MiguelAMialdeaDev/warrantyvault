<?xml version="1.0" encoding="utf-8"?>
<!--
  Reglas de backup / device transfer.

  El backup en la nube tiene una cuota de 25 MB por app. Las fotos de ticket se copian
  sin recomprimir (2-5 MB cada una), así que con pocas garantías se supera la cuota y
  Google deja de guardar el backup ENTERO, incluidas la BD Room y el DataStore. Por eso
  las fotos se excluyen solo del backup en la nube: es preferible recuperar las garantías
  sin fotos que no recuperar nada.

  El traspaso directo entre móviles (device-transfer) no tiene esa cuota, así que ahí sí
  viajan las fotos.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="ticket_photos" />
    </cloud-backup>
    <device-transfer />
</data-extraction-rules>
